generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model School {
  id                   String                @id @default(uuid())
  name                 String
  slug                 String                @unique
  email                String?
  phone                String?
  address              String?
  website              String?
  logoUrl              String?
  status               SchoolStatus          @default(ACTIVE)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  academicSessions     AcademicSession[]
  announcements        Announcement[]
  auditLogs            AuditLog[]
  examinations         Examination[]
  feeStructures        FeeStructure[]
  invoices             Invoice[]
  notifications        Notification[]
  parents              Parent[]
  classes              SchoolClass[]
  memberships          SchoolMembership[]
  students             Student[]
  subjects             Subject[]
  subscription         Subscription?
  subscriptionPayments SubscriptionPayment[]
  teachers             Teacher[]
  invitations          SchoolInvitation[]
}

model User {
  id                   String                  @id @default(uuid())
  email                String                  @unique
  firstName            String
  lastName             String
  phone                String?
  role                 UserRole
  status               UserStatus              @default(ACTIVE)
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  password             String
  auditLogs            AuditLog[]              @relation("AuditActor")
  notifications        NotificationRecipient[]
  parentProfile        Parent?
  memberships          SchoolMembership[]
  studentProfile       Student?
  teacherProfile       Teacher?
  passwordResetTokens  PasswordResetToken[]
  refreshTokens        RefreshToken[]
  sentSchoolInvitations SchoolInvitation[] @relation("SchoolInvitationCreator")
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model RefreshToken {
  id             String    @id @default(uuid())
  userId         String
  tokenHash      String    @unique
  expiresAt      DateTime
  revokedAt      DateTime?
  replacedById   String?
  createdAt      DateTime  @default(now())
  lastUsedAt     DateTime?
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
}

model SchoolInvitation {
  id             String    @id @default(uuid())
  schoolId       String
  createdById    String
  email          String
  role           UserRole
  employeeId     String?
  admissionNumber String?
  tokenHash      String    @unique
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdAt      DateTime  @default(now())
  school         School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  createdBy      User      @relation("SchoolInvitationCreator", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([schoolId, email])
  @@index([expiresAt])
}

model SchoolMembership {
  id        String   @id @default(uuid())
  userId    String
  schoolId  String
  role      UserRole
  createdAt DateTime @default(now())
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, schoolId])
  @@index([schoolId])
  @@index([userId])
}

model Student {
  id              String            @id @default(uuid())
  schoolId        String
  userId          String?           @unique
  admissionNumber String
  firstName       String
  middleName      String?
  lastName        String
  dateOfBirth     DateTime?
  gender          Gender?
  email           String?
  phone           String?
  address         String?
  photoUrl        String?
  admissionDate   DateTime?
  status          StudentStatus     @default(ACTIVE)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  attendance      Attendance[]
  enrollments     Enrollment[]
  invoices        Invoice[]
  payments        Payment[]
  results         Result[]
  school          School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user            User?             @relation(fields: [userId], references: [id])
  guardians       StudentGuardian[]

  @@unique([schoolId, admissionNumber])
  @@index([schoolId])
  @@index([lastName])
}

model Parent {
  id        String            @id @default(uuid())
  schoolId  String
  userId    String?           @unique
  firstName String
  lastName  String
  email     String?
  phone     String?
  address   String?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  school    School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user      User?             @relation(fields: [userId], references: [id])
  children  StudentGuardian[]

  @@index([schoolId])
}

model StudentGuardian {
  id           String           @id @default(uuid())
  studentId    String
  parentId     String
  relationship RelationshipType
  isPrimary    Boolean          @default(false)
  parent       Parent           @relation(fields: [parentId], references: [id], onDelete: Cascade)
  student      Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, parentId])
  @@index([parentId])
  @@index([studentId])
}

model Teacher {
  id                 String           @id @default(uuid())
  schoolId           String
  userId             String           @unique
  employeeId         String
  firstName          String
  lastName           String
  email              String?
  phone              String?
  address            String?
  photoUrl           String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  attendanceRecords  Attendance[]
  classAssignments   ClassTeacher[]
  results            Result[]
  school             School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjectAssignments TeacherSubject[]
  timetableEntries   TimetableEntry[]

  @@unique([schoolId, employeeId])
  @@index([schoolId])
}

model AcademicSession {
  id           String        @id @default(uuid())
  schoolId     String
  name         String
  startDate    DateTime
  endDate      DateTime
  isActive     Boolean       @default(false)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  school       School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  enrollments  Enrollment[]
  examinations Examination[]
  classes      SchoolClass[]
  terms        Term[]

  @@unique([schoolId, name])
  @@index([schoolId])
}

model Term {
  id                String          @id @default(uuid())
  academicSessionId String
  name              String
  type              TermType
  startDate         DateTime
  endDate           DateTime
  isActive          Boolean         @default(false)
  examinations      Examination[]
  feeStructures     FeeStructure[]
  invoices          Invoice[]
  results           Result[]
  academicSession   AcademicSession @relation(fields: [academicSessionId], references: [id], onDelete: Cascade)

  @@unique([academicSessionId, type])
}

model SchoolClass {
  id                String           @id @default(uuid())
  schoolId          String
  academicSessionId String
  name              String
  level             String?
  capacity          Int?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  announcements     Announcement[]
  attendance        Attendance[]
  subjects          ClassSubject[]
  teachers          ClassTeacher[]
  enrollments       Enrollment[]
  examinations      Examination[]
  academicSession   AcademicSession  @relation(fields: [academicSessionId], references: [id], onDelete: Cascade)
  school            School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  timetableEntries  TimetableEntry[]

  @@unique([schoolId, academicSessionId, name])
  @@index([schoolId])
}

model Subject {
  id                 String               @id @default(uuid())
  schoolId           String
  name               String
  code               String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  classAssignments   ClassSubject[]
  examinations       ExaminationSubject[]
  results            Result[]
  school             School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  teacherAssignments TeacherSubject[]
  timetableEntries   TimetableEntry[]

  @@unique([schoolId, name])
  @@index([schoolId])
}

model Enrollment {
  id                String           @id @default(uuid())
  studentId         String
  classId           String
  academicSessionId String
  status            EnrollmentStatus @default(ACTIVE)
  enrolledAt        DateTime         @default(now())
  academicSession   AcademicSession  @relation(fields: [academicSessionId], references: [id], onDelete: Cascade)
  class             SchoolClass      @relation(fields: [classId], references: [id], onDelete: Cascade)
  student           Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, academicSessionId])
  @@index([classId])
  @@index([studentId])
}

model ClassTeacher {
  id        String      @id @default(uuid())
  classId   String
  teacherId String
  isPrimary Boolean     @default(false)
  class     SchoolClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  teacher   Teacher     @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([classId, teacherId])
}

model ClassSubject {
  id        String      @id @default(uuid())
  classId   String
  subjectId String
  class     SchoolClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject   Subject     @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([classId, subjectId])
}

model TeacherSubject {
  id        String  @id @default(uuid())
  teacherId String
  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher   Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([teacherId, subjectId])
}

model Attendance {
  id        String           @id @default(uuid())
  studentId String
  teacherId String?
  classId   String
  date      DateTime
  status    AttendanceStatus
  note      String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  class     SchoolClass      @relation(fields: [classId], references: [id], onDelete: Cascade)
  student   Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  teacher   Teacher?         @relation(fields: [teacherId], references: [id])

  @@unique([studentId, date])
  @@index([classId, date])
  @@index([studentId, date])
}

model Examination {
  id        String               @id @default(uuid())
  schoolId  String
  sessionId String
  termId    String
  classId   String
  name      String
  status    ExaminationStatus    @default(DRAFT)
  startDate DateTime?
  endDate   DateTime?
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  class     SchoolClass          @relation(fields: [classId], references: [id], onDelete: Cascade)
  school    School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  session   AcademicSession      @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  term      Term                 @relation(fields: [termId], references: [id], onDelete: Cascade)
  subjects  ExaminationSubject[]
  results   Result[]

  @@index([schoolId])
  @@index([classId])
}

model ExaminationSubject {
  id            String      @id @default(uuid())
  examinationId String
  subjectId     String
  maxScore      Float       @default(100)
  examination   Examination @relation(fields: [examinationId], references: [id], onDelete: Cascade)
  subject       Subject     @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([examinationId, subjectId])
}

model Result {
  id            String      @id @default(uuid())
  studentId     String
  examinationId String
  subjectId     String
  teacherId     String?
  termId        String
  caScore       Float?
  examScore     Float?
  totalScore    Float
  grade         String?
  remark        String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  examination   Examination @relation(fields: [examinationId], references: [id], onDelete: Cascade)
  student       Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject       Subject     @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher       Teacher?    @relation(fields: [teacherId], references: [id])
  term          Term        @relation(fields: [termId], references: [id], onDelete: Cascade)

  @@unique([studentId, examinationId, subjectId])
  @@index([studentId])
  @@index([examinationId])
}

model FeeStructure {
  id          String    @id @default(uuid())
  schoolId    String
  termId      String
  name        String
  amount      Decimal   @db.Decimal(12, 2)
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  school      School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  term        Term      @relation(fields: [termId], references: [id], onDelete: Cascade)
  invoices    Invoice[]

  @@index([schoolId])
}

model Invoice {
  id             String        @id @default(uuid())
  schoolId       String
  studentId      String
  feeStructureId String?
  termId         String
  invoiceNumber  String
  amount         Decimal       @db.Decimal(12, 2)
  amountPaid     Decimal       @default(0) @db.Decimal(12, 2)
  status         InvoiceStatus @default(UNPAID)
  dueDate        DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  feeStructure   FeeStructure? @relation(fields: [feeStructureId], references: [id])
  school         School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student        Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  term           Term          @relation(fields: [termId], references: [id], onDelete: Cascade)
  payments       Payment[]

  @@unique([schoolId, invoiceNumber])
  @@index([studentId])
  @@index([schoolId])
}

model Payment {
  id        String        @id @default(uuid())
  schoolId  String
  studentId String
  invoiceId String?
  reference String        @unique
  amount    Decimal       @db.Decimal(12, 2)
  status    PaymentStatus @default(PENDING)
  provider  String        @default("PAYSTACK")
  paidAt    DateTime?
  metadata  Json?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  invoice   Invoice?      @relation(fields: [invoiceId], references: [id])
  student   Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([studentId])
}

model SubscriptionPayment {
  id             String        @id @default(uuid())
  schoolId       String
  subscriptionId String
  reference      String        @unique
  amount         Decimal       @db.Decimal(12, 2)
  status         PaymentStatus @default(PENDING)
  paidAt         DateTime?
  metadata       Json?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  school         School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  subscription   Subscription  @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([subscriptionId])
  @@index([status])
  @@index([createdAt])
}

model TimetableEntry {
  id        String      @id @default(uuid())
  classId   String
  subjectId String
  teacherId String?
  day       DayOfWeek
  startTime String
  endTime   String
  room      String?
  class     SchoolClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject   Subject     @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher   Teacher?    @relation(fields: [teacherId], references: [id])

  @@index([classId, day])
}

model Announcement {
  id          String               @id @default(uuid())
  schoolId    String
  classId     String?
  title       String
  content     String
  audience    AnnouncementAudience
  published   Boolean              @default(false)
  publishedAt DateTime?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  class       SchoolClass?         @relation(fields: [classId], references: [id])
  school      School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId])
}

model Notification {
  id         String                  @id @default(uuid())
  schoolId   String
  title      String
  message    String
  type       NotificationType
  createdAt  DateTime                @default(now())
  school     School                  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  recipients NotificationRecipient[]

  @@index([schoolId])
}

model NotificationRecipient {
  id             String       @id @default(uuid())
  notificationId String
  userId         String
  readAt         DateTime?
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([notificationId, userId])
  @@index([userId])
}

model Plan {
  id              String          @id @default(uuid())
  name            String          @unique
  description     String?
  price           Decimal         @db.Decimal(12, 2)
  billingInterval BillingInterval
  maxStudents     Int?
  maxTeachers     Int?
  maxParents      Int?
  isActive        Boolean         @default(true)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  subscriptions   Subscription[]
}

model Subscription {
  id                       String                @id @default(uuid())
  schoolId                 String                @unique
  planId                   String
  status                   SubscriptionStatus    @default(TRIAL)
  startDate                DateTime
  endDate                  DateTime
  cancelledAt              DateTime?
  paystackCustomerCode     String?
  paystackSubscriptionCode String?
  createdAt                DateTime              @default(now())
  updatedAt                DateTime              @updatedAt
  plan                     Plan                  @relation(fields: [planId], references: [id])
  school                   School                @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  subscriptionPayments     SubscriptionPayment[]

  @@index([planId])
  @@index([status])
}

model AuditLog {
  id         String   @id @default(uuid())
  schoolId   String?
  userId     String?
  action     String
  resource   String
  resourceId String?
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())
  school     School?  @relation(fields: [schoolId], references: [id])
  user       User?    @relation("AuditActor", fields: [userId], references: [id])

  @@index([schoolId])
  @@index([userId])
  @@index([createdAt])
}

enum UserRole {
  SUPER_ADMIN
  SCHOOL_ADMIN
  TEACHER
  ACCOUNTANT
  PARENT
  STUDENT
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum SchoolStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum StudentStatus {
  ACTIVE
  INACTIVE
  GRADUATED
  SUSPENDED
  TRANSFERRED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum RelationshipType {
  FATHER
  MOTHER
  GUARDIAN
  OTHER
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum TermType {
  FIRST
  SECOND
  THIRD
}

enum ExaminationStatus {
  DRAFT
  OPEN
  COMPLETED
  PUBLISHED
}

enum PaymentStatus {
  PENDING
  SUCCESSFUL
  FAILED
  REFUNDED
}

enum InvoiceStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

enum BillingInterval {
  MONTHLY
  TERMLY
  YEARLY
}

enum NotificationType {
  GENERAL
  ATTENDANCE
  RESULT
  PAYMENT
  ANNOUNCEMENT
  SYSTEM
}

enum AnnouncementAudience {
  ALL
  TEACHERS
  STUDENTS
  PARENTS
  ACCOUNTANTS
  SPECIFIC_CLASS
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  TRANSFERRED
  WITHDRAWN
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}
